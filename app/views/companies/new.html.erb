<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">
    企業登録
  </h1>

  <%= form_with model: @form, url: companies_path, local: true do |f| %>
    <% if @form.errors.any? %>
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-md">
        <p class="text-red-700 font-semibold mb-2">
          入力内容にエラーがあります(<%= @form.errors.count %>件):
        </p>
        <ul class="list-disc list-inside text-red-600 text-sm">
          <% @form.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :company_name, "企業名", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :company_name,
            class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :start_date, "受検期間 開始日", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.date_field :start_date,
              class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
      <div>
        <%= f.label :end_date, "受検期間 終了日", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.date_field :end_date,
              class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :hr_name, "初代担当者 氏名", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :hr_name,
            class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="mb-6">
      <%= f.label :hr_email, "初代担当者 メールアドレス", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.email_field :hr_email,
            class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <p class="text-xs text-gray-500 mt-1">
        登録後、このアドレスに招待メールが送信されます。
      </p>
    </div>

    <div class="flex justify-between items-center">
      <%= link_to "戻る",
            companies_path,
            class: "text-gray-600 hover:text-gray-800 underline" %>
      <%= f.submit "登録する",
            class: "bg-primary-green hover:opacity-80 text-white font-semibold py-2 px-6 rounded-md cursor-pointer transition-opacity" %>
    </div>
  <% end %>
</div>
