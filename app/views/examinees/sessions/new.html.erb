<% content_for(:title, "ログイン | ストレスチェック") %>
<% content_for(:header_title, "ストレスチェック ログイン") %>

<p class="text-gray-900 mb-6">以下の情報を入力してください</p>

<%= form_with url: examinees_sign_in_path, class: "space-y-5" do |f| %>
  <div>
    <%= f.label :company_id, "企業ID", class: "block text-gray-900 mb-2" %>
    <%= f.text_field :company_id,
          value: params[:company_id],
          placeholder: "例：123",
          autofocus: true,
          inputmode: "numeric",
          autocomplete: "off",
          class: "w-full px-3 py-3 text-base border border-gray-400 focus:outline-none focus:ring-2 focus:ring-employee-blue" %>
  </div>

  <div>
    <%= f.label :examinee_number, "受検者番号", class: "block text-gray-900 mb-2" %>
    <%= f.text_field :examinee_number,
          value: params[:examinee_number],
          placeholder: "例：12345",
          autocomplete: "username",
          class: "w-full px-3 py-3 text-base border border-gray-400 focus:outline-none focus:ring-2 focus:ring-employee-blue" %>
  </div>

  <div>
    <%= f.label :password, "パスワード", class: "block text-gray-900 mb-2" %>
    <%= f.password_field :password,
          placeholder: "パスワードを入力",
          autocomplete: "current-password",
          class: "w-full px-3 py-3 text-base border border-gray-400 focus:outline-none focus:ring-2 focus:ring-employee-blue" %>
    <% if @login_error.present? %>
      <p class="mt-2 text-sm text-red-600"><%= @login_error %></p>
    <% end %>
  </div>

  <div class="pt-6">
    <%= f.submit "ログインする",
          class: "block w-full py-3 bg-employee-blue text-white text-base hover:opacity-90 transition-opacity cursor-pointer" %>
  </div>
<% end %>

<p class="mt-6 text-center text-sm text-gray-500">
  パスワードをお忘れの場合は、<br>
  社内のストレスチェック担当者<br>
  にお問い合わせください。
</p>
