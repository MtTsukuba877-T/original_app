<% content_for(:title, "パスワード変更 | ストレスチェック") %>
<% content_for(:header_title, "パスワード変更") %>

<p class="text-gray-900">初回ログインのため、新しいパスワードを設定してください</p>
<p class="mt-1 mb-6 text-sm text-gray-500">※パスワードは半角英数字混在8文字以上で設定してください</p>

<%= form_with model: @employee, url: examinees_password_path, method: :patch, class: "space-y-5" do |f| %>
  <div>
    <%= f.label :password, "新しいパスワード", class: "block text-gray-900 mb-2" %>
    <%= f.password_field :password,
          placeholder: "8文字以上の半角英数字",
          autofocus: true,
          autocomplete: "new-password",
          class: "w-full px-3 py-3 text-base border border-gray-400 focus:outline-none focus:ring-2 focus:ring-employee-blue" %>
  </div>

  <div>
    <%= f.label :password_confirmation, "新しいパスワード（確認用）", class: "block text-gray-900 mb-2" %>
    <%= f.password_field :password_confirmation,
          placeholder: "もう一度入力してください",
          autocomplete: "new-password",
          class: "w-full px-3 py-3 text-base border border-gray-400 focus:outline-none focus:ring-2 focus:ring-employee-blue" %>
    <% @employee.errors.full_messages.each do |message| %>
      <p class="mt-2 text-sm text-red-600"><%= message %></p>
    <% end %>
  </div>

  <div class="pt-6">
    <%= f.submit "パスワードを変更する",
          class: "block w-full py-3 bg-employee-blue text-white text-base hover:opacity-90 transition-opacity cursor-pointer" %>
  </div>
<% end %>
