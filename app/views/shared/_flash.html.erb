<%# フラッシュメッセージ表示用 partial %>
<%# admin.html.erb / application.html.erb などから render "shared/flash" で呼び出す %>

<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <%
    # flash のタイプに応じてスタイルを切り替える
    # notice: 成功系(緑)、alert: 警告系(赤)、その他: 情報系(青)
    style_class = case type.to_s
                  when "notice"
                    "bg-green-100 border-green-400 text-green-800"
                  when "alert"
                    "bg-red-100 border-red-400 text-red-800"
                  else
                    "bg-blue-100 border-blue-400 text-blue-800"
                  end
  %>
  <div class="border-l-4 <%= style_class %> px-4 py-3" role="alert">
    <div class="max-w-6xl mx-auto">
      <%= message %>
    </div>
  </div>
<% end %>
