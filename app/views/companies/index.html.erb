<div class="flex justify-between items-start mb-6">
  <h1 class="text-3xl font-bold text-gray-800">
    企業一覧
  </h1>
  <%= link_to "新規企業登録",
        new_company_path,
        class: "bg-primary-green hover:opacity-80 text-white font-semibold py-2 px-4 rounded-md transition-opacity" %>
</div>

<% if @companies.any? %>
  <div class="overflow-x-auto">
    <table class="min-w-full border border-gray-200">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700 border-b border-gray-200 w-24">
            企業ID
          </th>
          <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700 border-b border-gray-200">
            企業名
          </th>
        </tr>
      </thead>
      <tbody>
        <% @companies.each do |company| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2 text-sm text-gray-800 border-b border-gray-100">
              <%= company.id %>
            </td>
            <td class="px-4 py-2 text-sm border-b border-gray-100">
              <%= link_to company.name,
                    company_path(company),
                    class: "text-blue-600 hover:text-blue-800 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="border border-dashed border-gray-300 rounded-md p-8 text-center text-gray-400">
    <p>登録されている企業はまだありません。</p>
  </div>
<% end %>
