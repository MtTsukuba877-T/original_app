<div class="min-h-screen bg-gray-50 px-4 py-8">
  <div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-lg shadow-md p-8">
      <div class="flex justify-between items-start mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-800 mb-2">
            企業一覧
          </h1>
          <p class="text-sm text-gray-500">
            ログイン中: <%= current_user.email %>(<%= current_user.role %>)
          </p>
        </div>
        <%= link_to "新規企業登録",
              "#",
              class: "bg-blue-500 text-white font-semibold py-2 px-4 rounded-md opacity-50 cursor-not-allowed" %>
      </div>

      <% if @companies.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full border border-gray-200">
            <thead class="bg-gray-100">
              <tr>
                <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700 border-b border-gray-200 w-24">
                  企業ID
                </th>
                <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700 border-b border-gray-200">
                  企業名
                </th>
              </tr>
            </thead>
            <tbody>
              <% @companies.each do |company| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-2 text-sm text-gray-800 border-b border-gray-100">
                    <%= company.id %>
                  </td>
                  <td class="px-4 py-2 text-sm border-b border-gray-100">
                    <%= link_to company.name,
                          "#",
                          class: "text-blue-600 opacity-50 cursor-not-allowed" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="border border-dashed border-gray-300 rounded-md p-8 text-center text-gray-400">
          <p>登録されている企業はまだありません。</p>
        </div>
      <% end %>

      <div class="mt-6 text-right">
        <%= button_to "ログアウト",
              destroy_user_session_path,
              method: :delete,
              class: "bg-gray-500 hover:bg-gray-600 text-white font-semibold py-2 px-4 rounded-md transition-colors cursor-pointer" %>
      </div>
    </div>
  </div>
</div>
