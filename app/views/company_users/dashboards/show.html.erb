<div class="flex-1 flex flex-col py-8">
  <h2 class="text-2xl font-bold text-gray-800 mb-8">
    操作メニュー
  </h2>

  <%# 上のスペーサー(伸縮する空白) %>
  <div class="flex-1"></div>

  <div class="grid grid-cols-3 gap-6">
    <%# ==================== ①受検者一覧 ==================== %>
    <%= link_to "#", class: "block bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow text-center" do %>
      <p class="text-lg font-semibold text-gray-800 mb-2">
        ①受検者一覧
      </p>
      <p class="text-sm text-gray-500">
        受検者名簿の確認・編集
      </p>
    <% end %>

    <%# ==================== ②受検案内一斉配信 ==================== %>
    <%= link_to "#", class: "block bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow text-center" do %>
      <p class="text-lg font-semibold text-gray-800 mb-2">
        ②受検案内一斉配信
      </p>
      <p class="text-sm text-gray-500">
        受検者にメールで受検案内を配信
      </p>
    <% end %>

    <%# ==================== ③受検状況一覧 ==================== %>
    <%= link_to "#", class: "block bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow text-center" do %>
      <p class="text-lg font-semibold text-gray-800 mb-2">
        ③受検状況一覧
      </p>
      <p class="text-sm text-gray-500">
        各受検者の受検状況を確認
      </p>
    <% end %>
  </div>

  <%# 下のスペーサー(伸縮する空白) %>
  <div class="flex-1"></div>
</div>
